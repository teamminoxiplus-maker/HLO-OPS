# Supabase — copy to .env.local and fill in from your Supabase project settings
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, used for CSV batch imports / admin seed and
# for ALL assessment reads/writes (the anon key must never touch leads).
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# MINOXIPLUS Free Hair Loss Assessment (spec §5)
# ---------------------------------------------------------------------------

# Public site origin (used in result emails / links).
NEXT_PUBLIC_SITE_URL=https://minoxiplus.com

# Resend — transactional result email. If unset, the submit still succeeds and
# the email step is skipped (useful for local dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=MINOXIPLUS <care@minoxiplus.com>

# Assessment admin access — comma-separated allowlist of emails permitted at
# /admin. An empty allowlist locks everyone out.
ADMIN_ALLOWLIST=

# Upstash Redis (REST) for submit rate limiting. If unset, an in-memory
# fallback is used (single-instance / dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kiosk mode PIN (spec §13). Required to unlock /kiosk.
KIOSK_PIN=

# Salt for hashing client IPs before storage (spec §11). Set any random string.
IP_HASH_SALT=
