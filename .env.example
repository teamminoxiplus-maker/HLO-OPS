# Supabase — copy to .env.local and fill in from your Supabase project settings
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, used for CSV batch imports / admin seed.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Email marketing (optional — only needed to SEND emails from the Email module)
# ---------------------------------------------------------------------------
# Resend API key (https://resend.com > API Keys). Server-only.
RESEND_API_KEY=your-resend-api-key
# Sender identity. Must be on a domain you've verified in Resend. If unset,
# the app falls back to Resend's shared test sender (onboarding@resend.dev),
# which can only deliver to your own Resend account email.
EMAIL_FROM=Happy Life Organics <news@happylifeorganics.ph>
